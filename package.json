{
  "name": "novi",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @novi/web dev",
    "build": "pnpm --filter @novi/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "db:generate": "pnpm --filter @novi/db generate",
    "db:migrate": "pnpm --filter @novi/db migrate",
    "pipeline": "pnpm --filter @novi/pipeline exec tsx src/cli.ts"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
